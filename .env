# ═══════════════════════════════════════════════════════════════
# 🌍 LEADER ORACLE SETTINGS (ERPC Leader Slot API)
# ═══════════════════════════════════════════════════════════════
# Endpoint برای Leader Slot Information API
ERPC_LEADER_API_ENDPOINT="https://edge.erpc.global"
ERPC_API_KEY="3e18191a-c008-48ae-ae1a-d694e58f6878"

# فیلترینگ جغرافیایی
# کدهای کشورهای مجاز (جدا شده با کاما)
ALLOWED_COUNTRIES="DE,NL,FR,GB,CH,BE,PL,SE,FI"

# مناطق مجاز (جدا شده با کاما)
ALLOWED_REGIONS="Europe,EU"

# حداکثر تأخیر مجاز از فرانکفورت (میلی‌ثانیه)
MAX_LATENCY_MS="30"

# ═══════════════════════════════════════════════════════════════
# WALLET PATHS
# ═══════════════════════════════════════════════════════════════
# Single wallet for arbitrage bot (pays swap + tip)
WALLET_KEYPAIR_PATH="/home/ubuntu/f/wallets/wallet_arb.json"

# ═══════════════════════════════════════════════════════════════
# ARBITRAGE BOT SETTINGS
# ═══════════════════════════════════════════════════════════════
# Expected SOL price in USD (for Tessera V layout calibration)
# Update this to a rough current price before starting
EXPECTED_SOL_PRICE_USD="150"

# BisonFi pool layout offsets (auto-detected at startup, override if needed)
# BISONFI_WSOL_OFFSET="72"
# BISONFI_USDC_OFFSET="80"

# Jupiter Metis local API
# Start with: ALLOW_CIRCULAR_ARBITRAGE=true ./metis
JUPITER_METIS_URL="http://127.0.0.1:8080"

# ═══════════════════════════════════════════════════════════════
# JITO SETTINGS
# ═══════════════════════════════════════════════════════════════
# این endpoint به‌صورت پویا بر اساس موقعیت لیدر انتخاب می‌شود
# Default: فرانکفورت (چون سرور ما در فرانکفورت است)
JITO_BLOCK_ENGINE_URL="https://frankfurt.mainnet.block-engine.jito.wtf"
JITO_AUTH_KEYPAIR="path/to/keypair.json"

# ═══════════════════════════════════════════════════════════════
# PROJECT CONFIG
# ═══════════════════════════════════════════════════════════════
CONFIG_PATH="config.json"
RUST_LOG=info
