# ═══════════════════════════════════════════════════════════════
# METIS CONFIGURATION FOR CIRCULAR ARBITRAGE
# ═══════════════════════════════════════════════════════════════

# Binary Key (نیاز به stake کردن 10,000 JUP دارد)
# برای دریافت از https://portal.metis.builders/ استفاده کنید
BINARY_KEY=YOUR_BINARY_KEY_HERE

# RPC Endpoint - از ERPC موجود استفاده می‌کنیم
RPC_URL=https://edge.erpc.global?api-key=3e18191a-c008-48ae-ae1a-d694e58f6878

# Yellowstone gRPC برای streaming (اختیاری اما برای performance بهتر است)
YELLOWSTONE_GRPC_ENDPOINT=https://grpc-fra6-1.erpc.global
YELLOWSTONE_GRPC_X_TOKEN=3e18191a-c008-48ae-ae1a-d694e58f6878

# ═══════════════════════════════════════════════════════════════
# ARBITRAGE SETTINGS
# ═══════════════════════════════════════════════════════════════

# فعال‌سازی آربیتراژ سیرکولار (SOL -> USDC -> SOL)
ALLOW_CIRCULAR_ARBITRAGE=true

# ═══════════════════════════════════════════════════════════════
# MARKET FILTERING
# ═══════════════════════════════════════════════════════════════

# توکن‌های اصلی برای فیلتر کردن استخرها
# فقط استخرهایی که حداقل 2 تا از این توکن‌ها را دارند لود می‌شوند
FILTER_MARKETS_WITH_MINTS=So11111111111111111111111111111111111111112,EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v,Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB

# توضیح آدرس‌های بالا:
# So11111111111111111111111111111111111111112 = SOL (Wrapped SOL)
# EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v = USDC
# Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB = USDT

# ═══════════════════════════════════════════════════════════════
# DEX FILTERING (اختیاری)
# ═══════════════════════════════════════════════════════════════

# فقط از DEX های معتبر استفاده کنید
# DEX_PROGRAM_IDS=675kPX9MHTjS2zt1qfr1NYHuzeLXfQM9H24wFSUt1Mp8,whirLbMiicVdio4qvUfM5KAg6Ct8VwpYzGff3uctyCc,CPMMoo8L3F4NbTegBCKVNunggL7H1ZpdTHKxQB5qKP1C

# توضیح:
# 675kPX9MHTjS2zt1qfr1NYHuzeLXfQM9H24wFSUt1Mp8 = Raydium
# whirLbMiicVdio4qvUfM5KAg6Ct8VwpYzGff3uctyCc = Orca Whirlpool
# CPMMoo8L3F4NbTegBCKVNunggL7H1ZpdTHKxQB5qKP1C = Raydium CPMM

# DEX هایی که مشکل‌ساز هستند را exclude کنید
# EXCLUDE_DEX_PROGRAM_IDS=

# ═══════════════════════════════════════════════════════════════
# SERVER SETTINGS
# ═══════════════════════════════════════════════════════════════

# آدرس و پورت سرور Metis
API_ENDPOINT=127.0.0.1:8080

# لاگ‌ها
RUST_LOG=info

# تنظیمات مارکت کش
MARKET_MODE=file
MARKET_CACHE=/home/user/4546657/metis/market-cache.json
